# Broker-provided CTP simulation/read-only probe template.
# Copy this file to ctp_broker_test.local.env and fill credentials only there.
# ctp_broker_test.local.env is ignored by git via *.local.env.

# Required local credentials from the broker simulation account.
CTP_USERID=
CTP_PASSWORD=

# Required broker/front settings.
CTP_BROKERID=
CTP_TD_ADDRESS=tcp://<td_host>:<td_port>
CTP_MD_ADDRESS=tcp://<md_host>:<md_port>
CTP_APPID=
CTP_AUTH_CODE=

# Usually optional. Leave empty unless the broker explicitly provides it.
CTP_PRODUCT_INFO=
