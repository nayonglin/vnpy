# SimNow CTP read-only probe template.
# Copy this file to ctp_simnow.local.env on your Mac and fill only local credentials there.
# ctp_simnow.local.env is intentionally ignored by git via *.local.

# Required local credentials from SimNow registration.
CTP_USERID=
CTP_PASSWORD=

# Public SimNow defaults. The Stage177 wrapper will set these if you leave them unset.
CTP_BROKERID=9999
CTP_APPID=simnow_client_test
CTP_AUTH_CODE=0000000000000000
CTP_PRODUCT_INFO=

# SIMNOW_FRONT choices:
# - 7x24: public 7x24 test front, useful for connectivity checks outside trading hours.
# - trading: first telecom front, closer to exchange trading hours.
# - trading2: second telecom front, closer to exchange trading hours.
# - trading_mobile: mobile network front, sometimes useful if telecom fronts are unreachable.
SIMNOW_FRONT=7x24

# Optional explicit override. Usually leave these empty and let SIMNOW_FRONT choose.
CTP_TD_ADDRESS=
CTP_MD_ADDRESS=
