# Official live email notification template.
# Copy this file to official_live_email.local.env and fill only local credentials there.
# official_live_email.local.env is ignored by git via *.local.env.

# Master switch. Keep 0 until you have run a dry-run/config check.
OFFICIAL_LIVE_EMAIL_ENABLED=0

# Keep dry-run=1 while testing. It writes .eml files under backtest_outputs
# instead of sending live email.
OFFICIAL_LIVE_EMAIL_DRY_RUN=1

# SMTP settings. Use app passwords or a dedicated mailbox when your provider requires it.
OFFICIAL_LIVE_EMAIL_SMTP_HOST=smtp.example.com
OFFICIAL_LIVE_EMAIL_SMTP_PORT=465
OFFICIAL_LIVE_EMAIL_USE_SSL=1
OFFICIAL_LIVE_EMAIL_STARTTLS=0
OFFICIAL_LIVE_EMAIL_SMTP_AUTH=1
OFFICIAL_LIVE_EMAIL_SMTP_USER=
OFFICIAL_LIVE_EMAIL_SMTP_PASSWORD=

# Sender and recipients. Multiple recipients can be separated by comma or semicolon.
OFFICIAL_LIVE_EMAIL_FROM=
OFFICIAL_LIVE_EMAIL_TO=
OFFICIAL_LIVE_EMAIL_CC=

# Optional safety knobs.
OFFICIAL_LIVE_EMAIL_TIMEOUT_SECONDS=15
OFFICIAL_LIVE_EMAIL_MAX_ATTACHMENT_BYTES=5000000
# OFFICIAL_LIVE_EMAIL_DISABLE_ATTACHMENTS=1
