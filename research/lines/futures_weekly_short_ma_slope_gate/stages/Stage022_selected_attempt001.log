                    "STAGE930_LOG_DIR": str(root / "logs"),
                    "STAGE930_SUPERVISOR_MAX_RESTARTS": "5",
                    "STAGE930_SUPERVISOR_RESTART_DELAY_SECONDS": "0.05",
